package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["system_bpfprogs_license"],
}

license {
    name: "system_bpfprogs_license",
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0",
    ],
    license_text: ["LICENSE"],
}

libbpf_prog {
    name: "timeInState.bpf",
    srcs: ["timeInState.c"],
    // emerald: clang 21 defaults to BPF ISA v3 and turns __sync_fetch_and_add on u32 into
    // atomic_fetch_add (BPF_ATOMIC|BPF_FETCH), which the 5.10 verifier rejects ("BPF_STX uses
    // reserved fields", kernel 5.12+). v2 emits the legacy XADD form that 5.10 accepts.
    cflags: ["-mcpu=v2"],
    header_libs: [
        "bpf_prog_headers",
        "libcutils_headers",
        "android_bpf_defs",
    ],
    relative_install_path: "cputimeinstate",
}

libbpf_prog {
    name: "fuseMedia.bpf",
    srcs: ["fuseMedia.c"],
    header_libs: [
        "android_bpf_defs",
        "libfuse_headers",
    ],
}
